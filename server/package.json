{
  "name": "fieldcrm-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "node --import tsx src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
